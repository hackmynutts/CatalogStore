@model List<CatalogStore.UI.Models.ProductImage.ProductImageViewModel>
@{
    ViewData["Title"] = "Imágenes de producto";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Imágenes de producto</h1>
</div>

<form style="display:none">@Html.AntiForgeryToken()</form>

<div class="app-table-search-wrap">
    <i class="fa-solid fa-magnifying-glass app-table-search-icon"></i>
    <input type="text" class="app-table-search" data-table-search="productImageTable" data-column="all" placeholder="Buscar imágenes..." />
</div>

<div class="table-responsive">
<table id="productImageTable" class="table app-table">
    <thead>
        <tr>
            <th class="sorter-false filter-false">Vista previa</th>
            <th>Producto</th>
            <th>Tipo de contenido</th>
            <th>Creado por</th>
            <th>Fecha</th>
            <th class="sorter-false filter-false">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var img in Model)
        {
            <tr>
                <td><img src="@img.Url" alt="Imagen" class="product-image-thumb" /></td>
                <td><a asp-controller="Product" asp-action="Details" asp-route-id="@img.ProductID">#@img.ProductID</a></td>
                <td>@(string.IsNullOrEmpty(img.ContentType) ? "—" : img.ContentType)</td>
                <td>@img.CreatedBy</td>
                <td>@img.CreatedOn.ToString("g")</td>
                <td class="text-end">
                    <div class="action-buttons">
                        <button type="button" class="btn btn-sm btn-outline-danger btn-delete-product-image" title="Eliminar" data-id="@img.ProductImageID"><i class="fa-solid fa-trash"></i></button>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<div id="productImageTable-pager" class="app-table-pager">
    <button type="button" class="btn btn-sm btn-outline-secondary first" title="Primera página"><i class="fa-solid fa-angles-left"></i></button>
    <button type="button" class="btn btn-sm btn-outline-secondary prev" title="Anterior"><i class="fa-solid fa-angle-left"></i></button>
    <span class="pagedisplay"></span>
    <button type="button" class="btn btn-sm btn-outline-secondary next" title="Siguiente"><i class="fa-solid fa-angle-right"></i></button>
    <button type="button" class="btn btn-sm btn-outline-secondary last" title="Última página"><i class="fa-solid fa-angles-right"></i></button>
    <select class="pagesize">
        <option value="10" selected>10 / página</option>
        <option value="25">25 / página</option>
        <option value="50">50 / página</option>
        <option value="100">100 / página</option>
    </select>
</div>

@if (!Model.Any())
{
    <div class="app-table-empty">
        <i class="fa-solid fa-image"></i>
        <span>No hay imágenes registradas.</span>
    </div>
}

@section Scripts {
    <script src="~/js/product-image.js" asp-append-version="true"></script>
}
