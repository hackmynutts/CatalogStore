@model CatalogStore.UI.Models.InventoryLine.InventoryLineViewModel
@{
    ViewData["Title"] = "Detalle de la línea";
    var inventoryName = ViewData["InventoryName"] as string ?? "Bodega";
    var transactions = ViewData["Transactions"] as List<CatalogStore.UI.Models.InventoryTransaction.InventoryTransactionViewModel>
        ?? new List<CatalogStore.UI.Models.InventoryTransaction.InventoryTransactionViewModel>();
}

<div class="detail-header">
    <div class="detail-header-left">
        <div class="detail-avatar"><i class="fa-solid fa-box"></i></div>
        <div>
            <h1 class="detail-title">@Model.ProductName</h1>
            <div class="detail-subtitle">
                @if (!string.IsNullOrWhiteSpace(Model.ProductCode))
                {
                    <span><a asp-controller="Product" asp-action="Details" asp-route-id="@Model.ProductID">@Model.ProductCode</a></span>
                }
                <span>en @inventoryName</span>
                @if (Model.StatusID == 1)
                {
                    <span class="badge badge-status-active">Activo</span>
                }
                else
                {
                    <span class="badge badge-status-inactive">Inactivo</span>
                }
                @if (Model.NeedsRestock)
                {
                    <span class="badge text-bg-warning">Reponer</span>
                }
            </div>
        </div>
    </div>
    <div class="detail-actions">
        <button type="button" class="btn btn-sm btn-outline-primary btn-edit-line" data-id="@Model.InventoryLineID" style="width:auto;"><i class="fa-solid fa-pen-to-square"></i> Editar</button>
        <a asp-controller="Inventory" asp-action="Details" asp-route-id="@Model.InventoryID" class="btn btn-sm btn-outline-secondary" style="width:auto;"><i class="fa-solid fa-arrow-left"></i> Volver a la bodega</a>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="info-card">
            <h2 class="info-card-title"><i class="fa-solid fa-boxes-stacked"></i> Existencias</h2>
            <div class="info-field-grid">
                <div>
                    <span class="info-field-label">Stock físico</span>
                    <span class="info-field-value">@Model.Quantity</span>
                </div>
                <div>
                    <span class="info-field-label">Reservado</span>
                    <span class="info-field-value">@Model.QuantityOnHold</span>
                </div>
                <div>
                    <span class="info-field-label">Disponible</span>
                    <span class="info-field-value">@Model.QuantityAvailable</span>
                </div>
                <div>
                    <span class="info-field-label">Mínimo para reponer</span>
                    <span class="info-field-value">@(Model.QuantityRestock > 0 ? Model.QuantityRestock.ToString() : "Sin aviso")</span>
                </div>
                <div>
                    <span class="info-field-label">Último reabastecimiento</span>
                    <span class="info-field-value">@(Model.LastRestock.HasValue ? Model.LastRestock.Value.ToString("d") : "—")</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="info-card">
            <h2 class="info-card-title">
                <i class="fa-solid fa-right-left"></i> Movimientos
                @* Una línea inactiva no acepta movimientos (la API también lo rechaza). *@
                @if (Model.StatusID == 1)
                {
                    <button type="button" class="btn btn-sm btn-brand ms-auto" style="width:auto; padding-left:16px; padding-right:16px;" id="btn-add-transaction" data-line-id="@Model.InventoryLineID"><i class="fa-solid fa-plus"></i> Registrar movimiento</button>
                }
            </h2>
            <partial name="~/Views/InventoryTransaction/_TransactionsPartial.cshtml" model="transactions" />
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="info-card">
            <h2 class="info-card-title"><i class="fa-solid fa-clock-rotate-left"></i> Auditoría</h2>
            <div class="info-field-grid">
                <div>
                    <span class="info-field-label">Creado por</span>
                    <span class="info-field-value">@Model.CreatedBy</span>
                </div>
                <div>
                    <span class="info-field-label">Creado el</span>
                    <span class="info-field-value">@Model.CreatedOn.ToString("g")</span>
                </div>
                <div>
                    <span class="info-field-label">Modificado por</span>
                    <span class="info-field-value">@(string.IsNullOrEmpty(Model.ModifiedBy) ? "—" : Model.ModifiedBy)</span>
                </div>
                <div>
                    <span class="info-field-label">Modificado el</span>
                    <span class="info-field-value">@(Model.ModifiedOn.HasValue ? Model.ModifiedOn.Value.ToString("g") : "—")</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal compartido: Editar (inventory-line.js) y Registrar movimiento (inventory-transaction.js) -->
<div class="modal fade" id="lineModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="lineModalContent"></div>
    </div>
</div>
<form style="display:none">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script src="~/js/inventory-line.js" asp-append-version="true"></script>
    <script src="~/js/inventory-transaction.js" asp-append-version="true"></script>
}
