@inject IConfiguration Configuration
@{
    // Etiquetas del <head> para buscadores y para las vistas previas al compartir el enlace (WhatsApp, Facebook, etc.).
    // Solo se indexan las páginas públicas (ViewData["Indexable"] = true) y solo cuando el sitio tiene su dirección pública
    // configurada (Seo:SiteUrl). Así una copia de pruebas o el panel interno nunca aparecen en Google.
    var siteUrl = (Configuration["Seo:SiteUrl"] ?? string.Empty).Trim().TrimEnd('/');
    bool configured = siteUrl.Length > 0;
    bool indexable = configured && ViewData["Indexable"] as bool? == true;

    string pageTitle = ViewData["FullTitle"] as string ?? $"{ViewData["Title"]} - SAM DESIGN";
    string description = ViewData["Description"] as string
        ?? "SAM DESIGN: capas impermeables, jackets de protección, guantes y accesorios para moto en Costa Rica.";
    var path = Context.Request.Path.Value ?? "/";
    string canonical = siteUrl + (path.Length > 1 ? path.TrimEnd('/') : "/");
    string image = siteUrl + "/img/og-sam-design.jpg";
}
<title>@pageTitle</title>
<meta name="description" content="@description" />
<meta name="robots" content="@(indexable ? "index, follow, max-image-preview:large" : "noindex, nofollow")" />
<meta name="theme-color" content="#2F5D50" />

<link rel="icon" href="~/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="48x48" href="~/favicon-48x48.png" />
<link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" />
<link rel="manifest" href="~/site.webmanifest" />

@if (indexable)
{
    <link rel="canonical" href="@canonical" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SAM DESIGN" />
    <meta property="og:locale" content="es_CR" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@image" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SAM DESIGN: capas, jackets, guantes y accesorios para moto" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@description" />
    <meta name="twitter:image" content="@image" />
}
