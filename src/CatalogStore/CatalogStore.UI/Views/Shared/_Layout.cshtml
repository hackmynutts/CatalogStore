<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CatalogStore.UI</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CatalogStore.UI.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        @{
            var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
            var ventasControllers = new[] { "Client", "Orden", "Product", "Inventario", "Vendedor" };
        }
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar mb-3">
            <div class="container-fluid">
                <a class="navbar-brand app-navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/img/logos/logo_pequeño-removebg-preview.png" alt="CatalogStore" class="app-navbar-logo" />
                    CatalogStore
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        @if (User.IsInRole("Admin") || User.IsInRole("AdminIT"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(currentController == "User" || currentController == "Status" || currentController == "Eventlog" ? "active" : "")" href="#" id="adminMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Administrativo
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="adminMenu">
                                    <li><a class="dropdown-item" asp-controller="User" asp-action="Index">Usuarios</a></li>
                                    <li><a class="dropdown-item" asp-controller="Status" asp-action="Index">Estados</a></li>
                                    <li><a class="dropdown-item" asp-controller="Eventlog" asp-action="Index">Bitácora de eventos</a></li>
                                    @* Submenú IT: solo para AdminIT *@
                                    @if (User.IsInRole("AdminIT"))
                                    {
                                        <li class="dropdown dropend">
                                            <a class="dropdown-item dropdown-toggle"
                                               href="#"
                                               data-bs-toggle="dropdown"
                                               data-bs-display="static"
                                               data-bs-auto-close="outside"
                                               aria-expanded="false">
                                                IT
                                            </a>
                                            <ul class="dropdown-menu shadow">

                                                @* ── Grupo: Administracion ── *@
                                                <li class="dropdown dropend">
                                                    <a class="dropdown-item dropdown-toggle"
                                                       href="#"
                                                       data-bs-toggle="dropdown"
                                                       data-bs-display="static"
                                                       data-bs-auto-close="outside"
                                                       aria-expanded="false">
                                                        Administración
                                                    </a>
                                                    <ul class="dropdown-menu shadow">
                                                        <li><a class="dropdown-item" asp-controller="Client" asp-action="IndexAdmin">Clientes</a></li>
                                                        <li><a class="dropdown-item" asp-controller="User" asp-action="Index">Usuarios</a></li>
                                                        <li><a class="dropdown-item" asp-controller="Status" asp-action="Index">Estados</a></li>
                                                        <li><a class="dropdown-item" asp-controller="Eventlog" asp-action="Index">Bitácora de eventos</a></li>
                                                    </ul>
                                                </li>
                                                @* ── Grupo: Administracion ── *@
                                                <li class="dropdown dropend">
                                                    <a class="dropdown-item dropdown-toggle"
                                                       href="#"
                                                       data-bs-toggle="dropdown"
                                                       data-bs-display="static"
                                                       data-bs-auto-close="outside"
                                                       aria-expanded="false">
                                                        Ventas
                                                    </a>
                                                    <ul class="dropdown-menu shadow">
                                                        <li><a class="dropdown-item" asp-controller="Sales" asp-action="IndexAdmin">Ventas</a></li>
                                                        <li><a class="dropdown-item" asp-controller="Orden" asp-action="Index">Órdenes</a></li>
                                                        <li><a class="dropdown-item" asp-controller="Product" asp-action="IndexAdmin">Productos</a></li>
                                                        <li><a class="dropdown-item" asp-controller="Inventario" asp-action="Index">Inventario</a></li>
                                                        <li><a class="dropdown-item" asp-controller="Vendedor" asp-action="Index">Vendedores</a></li>
                                                    </ul>
                                                </li>

                                            </ul>
                                        </li>
                                    }
                                </ul>
                            </li>
                            
                        }

                        @if (User.IsInRole("Admin") || User.IsInRole("AdminIT") || User.IsInRole("Vendedor"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(ventasControllers.Contains(currentController) ? "active" : "")" href="#" id="ventasMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Ventas
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="ventasMenu">
                                    <li><a class="dropdown-item" asp-controller="Client" asp-action="Index">Clientes</a></li>
                                    <li><a class="dropdown-item" asp-controller="Orden" asp-action="Index">Órdenes</a></li>
                                    <li><a class="dropdown-item" asp-controller="Product" asp-action="Index">Productos</a></li>
                                    <li><a class="dropdown-item" asp-controller="Inventario" asp-action="Index">Inventario</a></li>
                                    <li><a class="dropdown-item" asp-controller="Vendedor" asp-action="Index">Vendedores</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var email = User.FindFirst(System.IdentityModel.Tokens.Jwt.JwtRegisteredClaimNames.UniqueName)?.Value;
                            var roles = string.Join(", ", User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value));
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @email
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
                                    <li><span class="dropdown-item-text text-muted small">@roles</span></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Details">Mis datos</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="px-3 py-1">
                                            <button type="submit" class="btn btn-link p-0 text-decoration-none">Cerrar sesión</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - CatalogStore.UI - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.tablesorter/2.31.3/js/jquery.tablesorter.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.tablesorter/2.31.3/js/jquery.tablesorter.widgets.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.tablesorter/2.31.3/js/extras/jquery.tablesorter.pager.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/table-init.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
