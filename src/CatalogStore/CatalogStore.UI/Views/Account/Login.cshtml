@model CatalogStore.UI.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Iniciar sesión";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CatalogStore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-page">
        <div class="auth-card">
            <div class="auth-brand">
                <div class="auth-brand-mark">CS</div>
                <h1 class="auth-brand-title">CatalogStore</h1>
                <p class="auth-brand-subtitle">Ingresá con tu cuenta para continuar</p>
            </div>

            @if (ViewData["LoginError"] != null)
            {
                <div class="auth-alert" role="alert">
                    @ViewData["LoginError"]
                </div>
            }

            <form asp-controller="Account" asp-action="Login" method="post" class="auth-form" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="auth-input-group">
                    <label asp-for="email" class="form-label">Correo electrónico</label>
                    <input asp-for="email" type="email" class="form-control" placeholder="nombre@empresa.com" autocomplete="username" autofocus />
                    <span asp-validation-for="email" class="field-validation-error"></span>
                </div>

                <div class="auth-input-group">
                    <label asp-for="password" class="form-label">Contraseña</label>
                    <input asp-for="password" id="password-input" type="password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                    <button type="button" class="auth-toggle-password" id="toggle-password">Mostrar</button>
                    <span asp-validation-for="password" class="field-validation-error"></span>
                </div>

                <button type="submit" class="btn-brand">Iniciar sesión</button>
            </form>

            <div class="auth-footer">
                &copy; 2026 CatalogStore
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.getElementById('toggle-password').addEventListener('click', function () {
            const input = document.getElementById('password-input');
            const isHidden = input.type === 'password';
            input.type = isHidden ? 'text' : 'password';
            this.textContent = isHidden ? 'Ocultar' : 'Mostrar';
        });
    </script>
</body>
</html>
