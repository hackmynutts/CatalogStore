@model CatalogStore.UI.Models.User.ForgotPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Olvidé mi contraseña";
    bool sent = ViewData["Sent"] as bool? == true;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CatalogStore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-page">
        <div class="auth-card">
            <div class="auth-brand">
                <img src="~/img/logos/logo_pequeño-removebg-preview.png" alt="CatalogStore" class="auth-brand-logo" />
                <p class="auth-brand-title">Restablecer contraseña</p>
                <p class="auth-brand-subtitle">
                    @(sent ? "Revisá tu correo" : "Te enviamos un enlace para crear una contraseña nueva")
                </p>
            </div>

            @if (sent)
            {
                <div class="auth-notice" role="status">
                    Si <strong>@Model.Email</strong> está registrado, te llegará un correo con el enlace en unos minutos.
                </div>
                <p class="auth-hint">
                    El enlace vence en 60 minutos y se puede usar una sola vez. Si no lo ves, revisá la carpeta de spam o correo no deseado.
                </p>
            }
            else
            {
                @if (ViewData["FormError"] != null)
                {
                    <div class="auth-alert" role="alert">@ViewData["FormError"]</div>
                }

                <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="auth-form" novalidate>
                    <div class="auth-input-group">
                        <label asp-for="Email" class="form-label">Correo electrónico</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="nombre@empresa.com" autocomplete="username" autofocus />
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>

                    <button type="submit" class="btn-brand">Enviar enlace</button>
                </form>
            }

            <div class="auth-footer">
                <a asp-controller="Account" asp-action="Login">Volver a iniciar sesión</a>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
