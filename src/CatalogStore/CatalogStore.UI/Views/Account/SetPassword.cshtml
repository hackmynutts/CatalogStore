@model CatalogStore.UI.Models.User.SetPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = Model.IsInvite ? "Crear contraseña" : "Nueva contraseña";
    string? linkError = ViewData["LinkError"] as string;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* El enlace trae el token en la dirección: que no viaje como Referer a ningún otro sitio. *@
    <meta name="referrer" content="no-referrer" />
    <title>@ViewData["Title"] - CatalogStore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-page">
        <div class="auth-card">
            <div class="auth-brand">
                <img src="~/img/logos/logo_pequeño-removebg-preview.png" alt="CatalogStore" class="auth-brand-logo" />
                <p class="auth-brand-title">@ViewData["Title"]</p>
                @if (linkError == null)
                {
                    <p class="auth-brand-subtitle">
                        Hola @((string.IsNullOrWhiteSpace(Model.FullName) ? Model.UserName : Model.FullName)?.Trim()).
                        @(Model.IsInvite ? "Creá tu contraseña para entrar al sistema." : "Elegí una contraseña nueva.")
                    </p>
                }
            </div>

            @if (linkError != null)
            {
                <div class="auth-alert" role="alert">@linkError</div>
                @if (!Model.IsInvite)
                {
                    <a asp-controller="Account" asp-action="ForgotPassword" class="btn-brand auth-btn-link">Pedir un enlace nuevo</a>
                }
            }
            else
            {
                @if (ViewData["FormError"] != null)
                {
                    <div class="auth-alert" role="alert">@ViewData["FormError"]</div>
                }

                <form asp-controller="Account" asp-action="SetPassword" method="post" class="auth-form" novalidate>
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="Token" />
                    <input type="hidden" asp-for="Mode" />

                    @if (!string.IsNullOrWhiteSpace(Model.UserName))
                    {
                        @* Para que el administrador de contraseñas del navegador la guarde con el usuario correcto. *@
                        <input type="text" name="username-hint" value="@Model.UserName" autocomplete="username" hidden />
                    }

                    <div class="auth-input-group">
                        <label asp-for="NewPassword" class="form-label">Contraseña nueva</label>
                        <input asp-for="NewPassword" id="new-password" type="password" class="form-control" autocomplete="new-password" autofocus />
                        <button type="button" class="auth-toggle-password" data-toggle-for="new-password">Mostrar</button>
                        <span asp-validation-for="NewPassword" class="field-validation-error"></span>
                    </div>

                    <div class="auth-input-group">
                        <label asp-for="ConfirmPassword" class="form-label">Confirmar contraseña</label>
                        <input asp-for="ConfirmPassword" id="confirm-password" type="password" class="form-control" autocomplete="new-password" />
                        <button type="button" class="auth-toggle-password" data-toggle-for="confirm-password">Mostrar</button>
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                    </div>

                    <p class="auth-hint">Mínimo 8 caracteres, con al menos una mayúscula, una minúscula, un número y un símbolo.</p>

                    <button type="submit" class="btn-brand">Guardar contraseña</button>
                </form>
            }

            <div class="auth-footer">
                <a asp-controller="Account" asp-action="Login">Volver a iniciar sesión</a>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.querySelectorAll('[data-toggle-for]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const input = document.getElementById(btn.getAttribute('data-toggle-for'));
                const isHidden = input.type === 'password';
                input.type = isHidden ? 'text' : 'password';
                btn.textContent = isHidden ? 'Ocultar' : 'Mostrar';
            });
        });
    </script>
</body>
</html>
