@model CatalogStore.UI.Models.Order.OrderViewModel
@using CatalogStore.UI.Models.Order
@using CatalogStore.UI.Models.Client
@inject IConfiguration Configuration
@{
    Layout = null;
    var number = OrderDocs.ProformaNumber(Model.OrderNumber);
    var issued = OrderDocs.LocalNow();
    var validUntil = issued.Date.AddDays(OrderDocs.ProformaValidDays);
    var client = ViewData["Client"] as ClientViewModel;
    var discount = Model.Lines.Sum(l => l.UnitPrice * l.Quantity) - Model.Subtotal;
    string Money(decimal v) => "₡" + v.ToString("N2");
    var whatsApp = (Configuration["Landing:WhatsApp"] ?? string.Empty).Trim();
    var contactEmail = (Configuration["Landing:Email"] ?? string.Empty).Trim();
    var contact = string.Join(" · ", new[] { whatsApp, contactEmail }.Where(x => x.Length > 0));
    var email = client?.ClientEmail ?? string.Empty;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Proforma @number</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/print-docs.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
</head>
<body class="print-doc-page">
    <form id="proformaTokenForm" hidden>@Html.AntiForgeryToken()</form>

    <div class="print-toolbar">
        <a asp-action="Details" asp-route-id="@Model.OrderID" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Volver a la orden</a>
        <button type="button" class="btn btn-brand btn-sm" onclick="window.print()"><i class="fa-solid fa-print" aria-hidden="true"></i> Imprimir / guardar PDF</button>
        <button type="button" class="btn btn-outline-brand btn-sm" id="proformaEmailBtn" data-id="@Model.OrderID" data-email="@email" @(string.IsNullOrWhiteSpace(email) ? "disabled" : "")>
            <i class="fa-regular fa-envelope" aria-hidden="true"></i> Enviar por correo
        </button>
        <span class="print-toolbar-note">
            @(string.IsNullOrWhiteSpace(email) ? "El cliente no tiene correo registrado." : $"Se envía a {email}.")
            En el diálogo de impresión elegí "Guardar como PDF" para obtener el archivo.
        </span>
    </div>

    <main class="pf-sheet">
        <header class="pf-head">
            <div class="pf-brand">
                <img src="~/img/logos/logo_pequeño-removebg-preview.png" alt="SAM DESIGN" />
                <div class="pf-brand-name">SAM DESIGN</div>
                @if (contact.Length > 0)
                {
                    <div class="pf-brand-contact">@contact</div>
                }
            </div>
            <div class="pf-title">
                <h1>PROFORMA</h1>
                <div class="pf-number">@number</div>
                <div class="pf-dates">Fecha: @issued.ToString("dd/MM/yyyy")<br />Válida hasta: @validUntil.ToString("dd/MM/yyyy")</div>
            </div>
        </header>

        <section class="pf-parties">
            <div class="pf-box">
                <h2>Cliente</h2>
                <strong>@Model.ClientName</strong>@(string.IsNullOrWhiteSpace(Model.ClientCC) ? "" : $" ({Model.ClientCC})")<br />
                Identificación: @Model.ClientIdentification
                @if (client is not null)
                {
                    @if (!string.IsNullOrWhiteSpace(client.ClientPhone)) { <text><br />Tel. @client.ClientPhone</text> }
                    @if (!string.IsNullOrWhiteSpace(client.ClientEmail)) { <text><br />@client.ClientEmail</text> }
                    @if (!string.IsNullOrWhiteSpace(client.ClientAddress)) { <text><br />@client.ClientAddress</text> }
                }
            </div>
            <div class="pf-box">
                <h2>Detalle</h2>
                Orden: @Model.OrderNumber<br />
                Vendedor: @Model.CreatedBy<br />
                Moneda: colones (₡)<br />
                @(Model.ApplyIva ? "Precios más IVA (13 %)" : "Venta sin IVA")
            </div>
        </section>

        <table class="pf-table">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th class="num">Cant.</th>
                    <th class="num">Precio</th>
                    <th class="num">Desc.</th>
                    <th class="num">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model.Lines)
                {
                    <tr>
                        <td>@l.ProductName@if (!string.IsNullOrWhiteSpace(l.ProductCode)) { <span class="pf-code">@l.ProductCode</span> }</td>
                        <td class="num">@l.Quantity</td>
                        <td class="num">@Money(l.UnitPrice)</td>
                        <td class="num">@(l.Discount > 0 ? l.Discount.ToString("0.##") + " %" : "—")</td>
                        <td class="num">@Money(l.LineSubtotal)</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="pf-totals">
            <div><span>Subtotal</span><span>@Money(Model.Subtotal + discount)</span></div>
            @if (discount > 0)
            {
                <div><span>Descuento</span><span>− @Money(discount)</span></div>
            }
            <div><span>@(Model.ApplyIva ? "IVA" : "IVA (no aplica)")</span><span>@Money(Model.IvaTotal)</span></div>
            <div class="pf-total"><span>Total</span><span>@Money(Model.OrderTotalAmount)</span></div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="pf-notes"><strong>Notas:</strong> @Model.Notes</div>
        }

        <div class="pf-legal">
            Esta proforma es una cotización: los precios son válidos por @OrderDocs.ProformaValidDays días desde su fecha y no reserva mercadería.
            No es un comprobante fiscal ni una factura.
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.getElementById('proformaEmailBtn').addEventListener('click', async function () {
            const btn = this;
            const ask = await Swal.fire({
                icon: 'question', title: '¿Enviar la proforma?',
                html: 'Se le manda a <strong></strong> con el detalle en el cuerpo del correo.',
                showCancelButton: true, confirmButtonText: 'Enviar', cancelButtonText: 'Cancelar',
                didOpen: () => { Swal.getHtmlContainer().querySelector('strong').textContent = btn.dataset.email; }
            });
            if (!ask.isConfirmed) return;
            btn.disabled = true;
            const body = new FormData();
            body.append('__RequestVerificationToken', document.querySelector('#proformaTokenForm input[name="__RequestVerificationToken"]').value);
            let result;
            try { result = await (await fetch('/Order/ProformaEmail/' + btn.dataset.id, { method: 'POST', body })).json(); }
            catch { result = { success: false, message: 'No hubo respuesta del servidor.' }; }
            btn.disabled = false;
            if (result.success) Swal.fire({ icon: 'success', title: 'Proforma en cola', text: 'Sale en unos segundos.', timer: 2200, showConfirmButton: false });
            else Swal.fire({ icon: 'error', title: 'No se pudo enviar', text: result.message || 'Intentá de nuevo.' });
        });
    </script>
</body>
</html>
