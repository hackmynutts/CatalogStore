@model CatalogStore.UI.Models.Sales.SaleViewModel
@using CatalogStore.UI.Models.Sales
@{
    Layout = null;
    var printed = TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTime.UtcNow, "America/Costa_Rica");
    var vigentes = Model.Payments.Where(p => !p.IsVoided).ToList();
    string Money(decimal v) => "₡" + v.ToString("N2");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tiquete @Model.SaleNumber</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/print-docs.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
    <style media="print">@@page { size: 80mm auto; margin: 3mm; }</style>
</head>
<body class="print-doc-page">
    <div class="print-toolbar" style="max-width:302px;">
        <a asp-action="Details" asp-route-id="@Model.SalesHeaderID" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Volver</a>
        <button type="button" class="btn btn-brand btn-sm" onclick="window.print()"><i class="fa-solid fa-print" aria-hidden="true"></i> Imprimir</button>
    </div>

    <main class="rc-sheet">
        <div class="rc-center">
            <div class="rc-brand">SAM DESIGN</div>
            <div class="rc-title">TIQUETE DE CAJA</div>
            <div class="rc-legend">Comprobante no fiscal</div>
        </div>
        <hr class="rc-sep" />
        <div class="rc-row"><span>Venta</span><span>@Model.SaleNumber</span></div>
        <div class="rc-row"><span>Fecha</span><span>@Model.SaleDate.ToString("dd/MM/yyyy HH:mm")</span></div>
        <div>Cliente: @Model.ClientName</div>
        <div>Vendedor: @Model.Seller</div>
        <hr class="rc-sep" />

        @foreach (var l in Model.Lines)
        {
            <div class="rc-line">
                <div class="rc-line-name">@l.ProductName</div>
                <div class="rc-row">
                    <span>@l.Quantity x @Money(l.UnitPrice)@(l.Discount > 0 ? $" (-{l.Discount:0.##}%)" : "")</span>
                    <span>@Money(l.LineSubtotal)</span>
                </div>
            </div>
        }
        <hr class="rc-sep" />

        @if (Model.DiscountTotal > 0)
        {
            <div class="rc-row"><span>Subtotal</span><span>@Money(Model.Subtotal + Model.DiscountTotal)</span></div>
            <div class="rc-row"><span>Descuento</span><span>− @Money(Model.DiscountTotal)</span></div>
        }
        <div class="rc-row rc-total"><span>TOTAL</span><span>@Money(Model.TotalAmount)</span></div>
        <div class="rc-center rc-legend">Venta sin IVA</div>

        @if (vigentes.Count > 0)
        {
            <hr class="rc-sep" />
            @foreach (var p in vigentes)
            {
                <div class="rc-row"><span>@p.PaymentMethodName @p.PaymentDate.ToString("dd/MM")</span><span>@Money(p.Amount)</span></div>
            }
            <div class="rc-row"><span>Pagado</span><span>@Money(Model.AmountPaid)</span></div>
            <div class="rc-row"><span>Saldo</span><span>@Money(Model.Balance)</span></div>
            @if (Model.Balance > 0)
            {
                <div class="rc-legend">Vence: @Model.DueDate.ToString("dd/MM/yyyy")</div>
            }
        }
        else if (Model.Balance > 0)
        {
            <div class="rc-row"><span>Saldo</span><span>@Money(Model.Balance)</span></div>
            <div class="rc-legend">Vence: @Model.DueDate.ToString("dd/MM/yyyy")</div>
        }

        <hr class="rc-sep" />
        <div class="rc-center">¡Gracias por su compra!</div>
        <div class="rc-center rc-legend">Impreso @printed.ToString("dd/MM/yyyy HH:mm")</div>
    </main>
</body>
</html>
