@{
    int code = ViewData["StatusCode"] as int? ?? 404;
    string title = code switch
    {
        404 => "Página no encontrada",
        403 => "Acceso denegado",
        _ => "Ocurrió un error"
    };
    string message = code switch
    {
        404 => "La página que buscás no existe o todavía no está construida.",
        403 => "No tenés permiso para ver esta sección.",
        _ => "Algo salió mal. Probá de nuevo en unos minutos."
    };
    ViewData["Title"] = title;
}
<div class="status-page">
    <div class="status-card">
        <div class="status-code">@code</div>
        <h1>@title</h1>
        <p class="text-muted">@message</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-brand" style="width:auto; padding-left:24px; padding-right:24px;">Volver al inicio</a>
    </div>
</div>
