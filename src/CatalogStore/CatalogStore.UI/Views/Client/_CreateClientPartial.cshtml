@model CatalogStore.UI.Models.Client.AddClientViewModel

<div class="modal-header">
    <h5 class="modal-title">Nuevo cliente</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
</div>
<form id="createClientForm">
    @Html.AntiForgeryToken()
    <div class="modal-body">
        <div class="mb-3">
            <label asp-for="Identification" class="form-label">Cédula</label>
            <div class="input-group">
                <input asp-for="Identification" id="clientIdentification" class="form-control" />
                <button type="button" class="btn btn-outline-secondary" id="btn-lookup-client" style="width:auto;">
                    <i class="fa-solid fa-magnifying-glass"></i> Buscar
                </button>
            </div>
            <small class="text-muted" id="lookupStatus"></small>
        </div>

        <div class="mb-3">
            <label asp-for="Cabys" class="form-label">Actividad económica</label>
            <input asp-for="Cabys" id="clientCabys" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="ClientName" class="form-label">Nombre</label>
            <input asp-for="ClientName" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="ClientPhone" class="form-label">Teléfono</label>
            <input asp-for="ClientPhone" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="ClientEmail" class="form-label">Correo</label>
            <input asp-for="ClientEmail" type="email" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="CC" class="form-label">Conocido Como</label>
            <input asp-for="CC" class="form-control" />
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Provincia</label>
                <select id="provinciaSelect" class="form-select"></select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Cantón</label>
                <select id="cantonSelect" class="form-select"></select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Distrito</label>
                <select id="distritoSelect" class="form-select"></select>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="ClientAddress" class="form-label">Señas exactas</label>
            <input asp-for="ClientAddress" class="form-control" placeholder="Ej. 200m norte de la iglesia" />
        </div>

        <div class="mb-3">
            <label asp-for="DeliveryPartner" class="form-label">Encomienda de Entrega</label>
            <input asp-for="DeliveryPartner" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Credito" class="form-label">Crédito</label>
            <select asp-for="Credito" class="form-select">
                <option value="0">Contado</option>
                <option value="1">1 semana</option>
                <option value="2">2 semanas</option>
                <option value="3">3 semanas</option>
                <option value="4">1 mes</option>
                <option value="5">1 mes y medio</option>
            </select>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-brand" style="width:auto; padding-left:24px; padding-right:24px;">Crear cliente</button>
    </div>
</form>
