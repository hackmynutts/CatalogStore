@model CatalogStore.UI.Models.Client.ClientViewModel
@{
    ViewData["Title"] = "Detalle del cliente";
    bool canManage = User.IsInRole("Admin") || User.IsInRole("AdminIT") || User.IsInRole("Vendedor");
    bool canSeeAudit = User.IsInRole("Admin") || User.IsInRole("AdminIT");
    var clientOrders = ViewData["Orders"] as List<CatalogStore.UI.Models.Order.OrderListItemViewModel> ?? new();
    string CreditoLabel(int? c) => c switch
    {
        0 => "Contado",
        1 => "1 semana",
        2 => "2 semanas",
        3 => "3 semanas",
        4 => "1 mes",
        5 => "1 mes y medio",
        _ => "—"
    };
    var initials = string.Join("", Model.ClientName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpper(w[0])));
}

<div class="detail-header">
    <div class="detail-header-left">
        <div class="detail-avatar">@initials</div>
        <div>
            <h1 class="detail-title">@Model.ClientName</h1>
            <div class="detail-subtitle">
                <span>Cédula @Model.Identification</span>
                @if (Model.StatusID == 1)
                {
                    <span class="badge badge-status-active">Activo</span>
                }
                else
                {
                    <span class="badge badge-status-inactive">Inactivo</span>
                }
            </div>
        </div>
    </div>
    <div class="detail-actions">
        @if (canManage && Model.StatusID == 1)
        {
            <form id="orderStartTokenForm" hidden>@Html.AntiForgeryToken()</form>
            <button type="button" class="btn btn-sm btn-brand btn-brand-auto btn-start-order" data-client-id="@Model.Id" data-client-name="@Model.ClientName">
                <i class="fa-solid fa-cart-plus" aria-hidden="true"></i> Iniciar orden
            </button>
        }
        @if (canManage)
        {
            <button type="button" class="btn btn-sm btn-outline-primary btn-edit-client" data-id="@Model.Id" style="width:auto;"><i class="fa-solid fa-pen-to-square"></i> Editar</button>
        }
        <a asp-controller="Client" asp-action="Index" class="btn btn-sm btn-outline-secondary" style="width:auto;"><i class="fa-solid fa-arrow-left"></i> Volver</a>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="info-card">
            <h2 class="info-card-title"><i class="fa-solid fa-address-card"></i> Datos de contacto</h2>
            <div class="info-field-grid">
                <div>
                    <span class="info-field-label">Conocido Como</span>
                    <span class="info-field-value">@(string.IsNullOrEmpty(Model.CC) ? "—" : Model.CC)</span>
                </div>
                <div>
                    <span class="info-field-label">Crédito</span>
                    <span class="info-field-value">@CreditoLabel(Model.Credito)</span>
                </div>
                <div>
                    <span class="info-field-label">Teléfono</span>
                    <span class="info-field-value">@Model.ClientPhone</span>
                </div>
                <div>
                    <span class="info-field-label">Correo</span>
                    <span class="info-field-value">@Model.ClientEmail</span>
                </div>
                <div>
                    <span class="info-field-label">Actividad económica</span>
                    <span class="info-field-value">@(string.IsNullOrEmpty(Model.Cabys) ? "—" : Model.Cabys)</span>
                </div>
                <div style="grid-column: 1 / -1;">
                    <span class="info-field-label">Dirección</span>
                    <span class="info-field-value">@(string.IsNullOrEmpty(Model.ClientAddress) ? "—" : Model.ClientAddress)</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="info-card">
            <h2 class="info-card-title">
                <i class="fa-solid fa-file-invoice"></i> Órdenes
                @if (clientOrders.Any())
                {
                    <a class="order-card-link" asp-controller="Order" asp-action="Index" asp-route-clientId="@Model.Id">Ver todas (@clientOrders.Count)</a>
                }
            </h2>
            @if (!clientOrders.Any())
            {
                <div class="app-table-empty">
                    <i class="fa-solid fa-file-invoice"></i>
                    <span>Este cliente todavía no tiene órdenes registradas.</span>
                </div>
            }
            else
            {
                <ul class="client-order-list">
                    @foreach (var o in clientOrders.Take(5))
                    {
                        <li>
                            <a asp-controller="Order" asp-action="Details" asp-route-id="@o.OrderID" class="client-order-item">
                                <span class="client-order-main">
                                    <span class="client-order-number">@o.OrderNumber</span>
                                    <span class="client-order-meta">@o.CreatedOn.ToString("g") · @(o.LineCount == 1 ? "1 producto" : $"{o.LineCount} productos")</span>
                                </span>
                                <span class="client-order-side">
                                    <span class="badge @CatalogStore.UI.Models.Order.OrderStatusStyle.BadgeClass(o.OrderStatus)">@o.OrderStatusName</span>
                                    <span class="client-order-total">₡@o.OrderTotalAmount.ToString("N2")</span>
                                </span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <div class="col-lg-6">
        <div class="info-card info-card-placeholder">
            <h2 class="info-card-title"><i class="fa-solid fa-cart-shopping"></i> Ventas <span class="info-card-soon">Próximamente</span></h2>
            <div class="app-table-empty">
                <i class="fa-solid fa-cart-shopping"></i>
                <span>Este cliente todavía no tiene ventas registradas.</span>
            </div>
        </div>
    </div>
</div>

@if (canSeeAudit)
{
    <div class="row">
        <div class="col-12">
            <div class="info-card">
                <h2 class="info-card-title"><i class="fa-solid fa-clock-rotate-left"></i> Auditoría</h2>
                <div class="info-field-grid">
                    <div>
                        <span class="info-field-label">Creado por</span>
                        <span class="info-field-value">@Model.CreatedBy</span>
                    </div>
                    <div>
                        <span class="info-field-label">Creado el</span>
                        <span class="info-field-value">@Model.CreatedOn.ToString("g")</span>
                    </div>
                    <div>
                        <span class="info-field-label">Modificado por</span>
                        <span class="info-field-value">@(string.IsNullOrEmpty(Model.ModifiedBy) ? "—" : Model.ModifiedBy)</span>
                    </div>
                    <div>
                        <span class="info-field-label">Modificado el</span>
                        <span class="info-field-value">@(Model.ModifiedOn.HasValue ? Model.ModifiedOn.Value.ToString("g") : "—")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/client.js" asp-append-version="true"></script>

    @if (canManage)
    {
        <!-- Modal de edición (mismo partial que usa el listado) -->
        <div class="modal fade" id="editClientModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content" id="editClientModalContent"></div>
            </div>
        </div>
        <form style="display:none">@Html.AntiForgeryToken()</form>
        <script src="~/js/order-start.js" asp-append-version="true"></script>
    }
}
