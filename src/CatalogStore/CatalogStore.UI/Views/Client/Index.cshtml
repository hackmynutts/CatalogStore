@model List<CatalogStore.UI.Models.Client.ClientViewModel>
@{
    ViewData["Title"] = "Clientes";
    bool canManage = User.IsInRole("Admin") || User.IsInRole("AdminIT") || User.IsInRole("Vendedor");
    bool canDelete = User.IsInRole("Admin") || User.IsInRole("AdminIT");
    bool canSeeAll = User.IsInRole("Admin") || User.IsInRole("AdminIT");
    bool isAdminView = ViewContext.RouteData.Values["action"]?.ToString() == "IndexAdmin";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Clientes</h1>
    <div class="d-flex gap-2">
        @if (canSeeAll)
        {
            @if (isAdminView)
            {
                <a asp-controller="Client" asp-action="Index" class="btn btn-outline-secondary" style="width:auto;">Ver solo activos</a>
            }
            else
            {
                <a asp-controller="Client" asp-action="IndexAdmin" class="btn btn-outline-secondary" style="width:auto;">Ver todos</a>
            }
        }
        @if (canManage)
        {
            <button type="button" class="btn btn-brand" style="width:auto; padding-left:24px; padding-right:24px;" id="btn-new-client"><i class="fa-solid fa-plus"></i> Nuevo cliente</button>
        }
    </div>
</div>

<form style="display:none">@Html.AntiForgeryToken()</form>

<div class="app-table-search-wrap">
    <i class="fa-solid fa-magnifying-glass app-table-search-icon"></i>
    <input type="text" class="app-table-search" data-table-search="clientTable" data-column="all" placeholder="Buscar clientes..." />
</div>

<div class="table-responsive">
<table id="clientTable" class="table app-table">
    <thead>
        <tr>
            <th>Cédula</th>
            <th>Nombre</th>
            <th>Teléfono</th>
            <th>Correo</th>
            <th>Estado</th>
            <th>Creado por</th>
            <th>Fecha</th>
            <th class="sorter-false filter-false">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Identification</td>
                <td>@c.ClientName</td>
                <td>@c.ClientPhone</td>
                <td>@c.ClientEmail</td>
                <td>
                    @if (c.StatusID == 1)
                    {
                        <span class="badge badge-status-active">Activo</span>
                    }
                    else
                    {
                        <span class="badge badge-status-inactive">Inactivo</span>
                    }
                </td>
                <td>@c.CreatedBy</td>
                <td>@c.CreatedOn.ToString("g")</td>
                <td class="text-end">
                    <div class="action-buttons">
                        <a class="btn btn-sm btn-outline-secondary" title="Ver detalle" asp-action="Details" asp-route-id="@c.Id"><i class="fa-solid fa-eye"></i></a>
                        @if (canManage)
                        {
                            <span class="action-sep">|</span>
                            <button type="button" class="btn btn-sm btn-outline-primary btn-edit-client" title="Editar" data-id="@c.Id"><i class="fa-solid fa-pen-to-square"></i></button>
                            @if (c.StatusID == 1)
                            {
                                <span class="action-sep">|</span>
                                <button type="button" class="btn btn-sm btn-outline-warning btn-inactivate-client" title="Inactivar" data-id="@c.Id" data-name="@c.ClientName"><i class="fa-solid fa-ban"></i></button>
                            }
                        }
                        @if (canDelete)
                        {
                            <span class="action-sep">|</span>
                            <button type="button" class="btn btn-sm btn-outline-danger btn-delete-client" title="Eliminar" data-id="@c.Id" data-name="@c.ClientName"><i class="fa-solid fa-trash"></i></button>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<div id="clientTable-pager" class="app-table-pager">
    <button type="button" class="btn btn-sm btn-outline-secondary first" title="Primera página"><i class="fa-solid fa-angles-left"></i></button>
    <button type="button" class="btn btn-sm btn-outline-secondary prev" title="Anterior"><i class="fa-solid fa-angle-left"></i></button>
    <span class="pagedisplay"></span>
    <button type="button" class="btn btn-sm btn-outline-secondary next" title="Siguiente"><i class="fa-solid fa-angle-right"></i></button>
    <button type="button" class="btn btn-sm btn-outline-secondary last" title="Última página"><i class="fa-solid fa-angles-right"></i></button>
    <select class="pagesize">
        <option value="10" selected>10 / página</option>
        <option value="25">25 / página</option>
        <option value="50">50 / página</option>
        <option value="100">100 / página</option>
    </select>
</div>

@if (!Model.Any())
{
    <div class="app-table-empty">
        <i class="fa-solid fa-user-group"></i>
        <span>No hay clientes para mostrar.</span>
    </div>
}

@if (canManage)
{
    <!-- Modal de edición -->
    <div class="modal fade" id="editClientModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" id="editClientModalContent"></div>
        </div>
    </div>

    <!-- Modal de creación -->
    <div class="modal fade" id="createClientModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" id="createClientModalContent"></div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/client.js" asp-append-version="true"></script>
}
