@model List<CatalogStore.UI.Models.Status.StatusViewModel>
@{
    ViewData["Title"] = "Estados";
    bool canManage = User.IsInRole("Admin") || User.IsInRole("AdminIT");
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Estados</h1>
    @if (canManage)
    {
        <button type="button" class="btn btn-brand" style="width:auto; padding-left:24px; padding-right:24px;" id="btn-new-status"><i class="fa-solid fa-plus"></i> Nuevo estado</button>
    }
</div>

<form style="display:none">@Html.AntiForgeryToken()</form>

<div class="app-table-search-wrap">
    <i class="fa-solid fa-magnifying-glass app-table-search-icon"></i>
    <input type="text" class="app-table-search" data-table-search="statusTable" data-column="all" placeholder="Buscar estados..." />
</div>

<div class="table-responsive">
<table id="statusTable" class="table app-table">
    <thead>
        <tr>
            <th>#</th>
            <th>Nombre</th>
            <th>Creado por</th>
            <th>Fecha</th>
            @if (canManage)
            {
                <th class="sorter-false filter-false">Acciones</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.StatusID</td>
                <td>@s.Name</td>
                <td>@s.CreatedBy</td>
                <td>@s.CreatedOn.ToString("g")</td>
                @if (canManage)
                {
                    <td class="text-end">
                        <div class="action-buttons">
                            <button type="button" class="btn btn-sm btn-outline-primary btn-edit-status" title="Editar" data-id="@s.StatusID"><i class="fa-solid fa-pen-to-square"></i></button>
                            <span class="action-sep">|</span>
                            <button type="button" class="btn btn-sm btn-outline-danger btn-delete-status" title="Eliminar" data-id="@s.StatusID" data-name="@s.Name"><i class="fa-solid fa-trash"></i></button>
                        </div>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
</div>

<div id="statusTable-pager" class="app-table-pager">
    <button type="button" class="btn btn-sm btn-outline-secondary first" title="Primera página"><i class="fa-solid fa-angles-left"></i></button>
    <button type="button" class="btn btn-sm btn-outline-secondary prev" title="Anterior"><i class="fa-solid fa-angle-left"></i></button>
    <span class="pagedisplay"></span>
    <button type="button" class="btn btn-sm btn-outline-secondary next" title="Siguiente"><i class="fa-solid fa-angle-right"></i></button>
    <button type="button" class="btn btn-sm btn-outline-secondary last" title="Última página"><i class="fa-solid fa-angles-right"></i></button>
    <select class="pagesize">
        <option value="10" selected>10 / página</option>
        <option value="25">25 / página</option>
        <option value="50">50 / página</option>
        <option value="100">100 / página</option>
    </select>
</div>

@if (!Model.Any())
{
    <div class="app-table-empty">
        <i class="fa-solid fa-tags"></i>
        <span>No hay estados para mostrar.</span>
    </div>
}

@if (canManage)
{
    <!-- Modal de edición -->
    <div class="modal fade" id="editStatusModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" id="editStatusModalContent"></div>
        </div>
    </div>

    <!-- Modal de creación -->
    <div class="modal fade" id="createStatusModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" id="createStatusModalContent"></div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/status.js" asp-append-version="true"></script>
}
